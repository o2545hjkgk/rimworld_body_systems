<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!--
		Stored body composition, as hidden data hediffs. Fat and muscle severity is adult-equivalent kg
		(real kg = severity × body size); height severity is adult height in cm. Weight (Physique_Weight)
		is derived from them, with the frame scaled by height.
	-->

	<HediffDef>
		<defName>Physique_Fat</defName>
		<label>body fat</label>
		<description>Stored body fat. Food eaten past a full stomach is added here, and it is burned off while hungry.</description>
		<hediffClass>Physique.Hediffs.Hediff_BodyFat</hediffClass>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<initialSeverity>14</initialSeverity>
		<minSeverity>0.1</minSeverity>
		<!-- Safety limit only; the real weight cap is maxBmi on Physique_Weight. -->
		<maxSeverity>2000</maxSeverity>
	</HediffDef>

	<HediffDef>
		<defName>Physique_Muscle</defName>
		<label>muscle</label>
		<description>Skeletal muscle. Starvation wastes it once body fat is down to essential levels.</description>
		<hediffClass>Physique.Hediffs.Hediff_Muscle</hediffClass>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<initialSeverity>26</initialSeverity>
		<!-- Severe wasting: for a 1.75 m adult with essential fat this is about BMI 12.4, Emaciated. -->
		<minSeverity>5</minSeverity>
		<maxSeverity>60</maxSeverity>
	</HediffDef>

	<HediffDef>
		<defName>Physique_Height</defName>
		<label>height</label>
		<description>How tall this person is, or will be once fully grown. Malnutrition while growing up permanently lowers it.</description>
		<hediffClass>Physique.Hediffs.Hediff_Height</hediffClass>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<initialSeverity>175</initialSeverity>
		<minSeverity>100</minSeverity>
		<maxSeverity>250</maxSeverity>
	</HediffDef>
</Defs>
